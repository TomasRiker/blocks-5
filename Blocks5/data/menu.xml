<?xml version="1.0" encoding="ISO-8859-1"?>
<Dialog>
	<Element name="Menu" x="0" y="0" w="640" h="480">
		<StaticText name="Version" x="5" y="5">
			<Font>tooltip_font.xml</Font>
		</StaticText>
		<!-- Die Felder in buttons.png sind 80x80 (grosse Knoepfe) und 50x50
		     (kleine), luecklos gepackt: Spalte 0 ungedrueckt, Spalte 80 bzw.
		     210 gedrueckt. Die Scheibe selbst ist unveraendert 64 bzw. 32
		     Pixel gross und liegt jetzt in *beiden* Zustaenden mittig im
		     Feld - vorher sass sie ungedrueckt in der linken oberen Ecke und
		     nur gedrueckt mittig. Deshalb reagierte ein Knopf von links
		     frueher auf die Maus als von rechts, und ein zu grosses Bild
		     ragte ins Nachbarfeld. Damit die Scheibe an derselben Stelle auf
		     dem Bildschirm bleibt, ruecken alle x/y um den neuen Rand nach
		     oben links: 8 Pixel bei den grossen, 9 bei den kleinen. -->
		<Button name="StartGame" x="12" y="97" w="80" h="80">
			<ExtendedStyle inset="8" />
			<Font>tooltip_font.xml</Font>
			<Title>$MM_START_GAME</Title>
			<Image u="0" v="0" u2="80" v2="0">buttons.png</Image>
		</Button>
		<Button name="LevelEditor" x="97" y="82" w="80" h="80">
			<ExtendedStyle inset="8" />
			<Font>tooltip_font.xml</Font>
			<Title>$MM_LEVEL_EDITOR</Title>
			<Image u="0" v="80" u2="80" v2="80">buttons.png</Image>
		</Button>
		<Button name="CampaignEditor" x="182" y="77" w="80" h="80">
			<ExtendedStyle inset="8" />
			<Font>tooltip_font.xml</Font>
			<Title>$MM_CAMPAIGN_EDITOR</Title>
			<Image u="0" v="160" u2="80" v2="160">buttons.png</Image>
		</Button>
		<!-- Import und Export. Ein Knopf nimmt eine Datei an und erkennt
		     selbst, was sie ist; der andere fragt, was hinausgehen soll.
		     Beide auf beiden Plattformen: unter Windows ist der Weg ins
		     Benutzerverzeichnis zwar offen, aber ihn zu suchen ist laestig.
		     Sie sind klein wie die Knoepfe der Levelauswahl - es sind
		     Nebensachen, keine Hauptwege - und stehen als Paar enger
		     beieinander als die grossen, mittig in deren Luecke und auf
		     deren Bogen. -->
		<Button name="Import" x="268" y="82" w="50" h="50">
			<ExtendedStyle inset="9" />
			<Font>tooltip_font.xml</Font>
			<Title>$MM_IMPORT</Title>
			<Image u="160" v="250" u2="210" v2="250">buttons.png</Image>
		</Button>
		<Button name="Export" x="318" y="82" w="50" h="50">
			<ExtendedStyle inset="9" />
			<Font>tooltip_font.xml</Font>
			<Title>$MM_EXPORT</Title>
			<Image u="160" v="300" u2="210" v2="300">buttons.png</Image>
		</Button>
		<Button name="Options" x="462" y="52" w="80" h="80">
			<ExtendedStyle inset="8" />
			<Font>tooltip_font.xml</Font>
			<Title>$OPTIONS</Title>
			<Image u="0" v="240" u2="80" v2="240">buttons.png</Image>
		</Button>
		<Button name="Help" x="542" y="82" w="80" h="80">
			<ExtendedStyle inset="8" />
			<Font>tooltip_font.xml</Font>
			<Title>$HELP</Title>
			<Image u="0" v="320" u2="80" v2="320">buttons.png</Image>
		</Button>
		<Button name="Quit" x="547" y="377" w="80" h="80">
			<ExtendedStyle inset="8" />
			<Font>tooltip_font.xml</Font>
			<Title>$MM_QUIT</Title>
			<Image u="0" v="400" u2="80" v2="400">buttons.png</Image>
		</Button>
		<!-- Die Adresse oben rechts gehoert zu menu.png und ist damit kein
		     eigenes Element. Dieser Knopf liegt nur darueber: ExtendedStyle
		     ohne Bild und ohne Titel zeichnet nichts. Gemessen im fertigen
		     Bild - der Text steht bei x 474..636, y 8..22. -->
		<Button name="Website" x="470" y="4" w="170" h="22">
			<ExtendedStyle />
			<Title></Title>
		</Button>
		<Button name="Donate" x="330" y="5" w="100" h="43">
			<ExtendedStyle />
			<Title></Title>
			<Image>$MM_DONATE_BUTTON_FILENAME</Image>
		</Button>
		<Element name="DonatePane" w="640" h="480">
			<Hidden />
			<Fill r="0" g="0" b="0" a="0.5" />
			<Window name="Donate" w="400" h="300">
				<Title>$MM_DONATE</Title>
				<Center />
				<StaticImage name="Static1" x="1" y="27" w="398" h="270">
					<Deactivated />
					<Image>$MM_DONATE_BACKGROUND_FILENAME</Image>
				</StaticImage>
				<Button name="NoThanks" x="200" y="260" w="100" h="30">
					<Title>$MM_DONATE_NO_THANKS</Title>
				</Button>
				<Button name="Donate" x="310" y="260" w="80" h="30">
					<Title>$MM_DONATE_DONATE</Title>
				</Button>
			</Window>
		</Element>

		<!-- Der Export fragt zuerst, was hinaus soll. Die Art waehlt man mit
		     vier Knopf-Radios, die Sache selbst aus der Liste darunter; die
		     Liste wird bei jedem Wechsel der Art neu eingelesen, und
		     "Aktualisieren" liest sie noch einmal ein, falls sich nebenher
		     etwas geaendert hat. -->
		<Element name="ExportPane" w="640" h="480">
			<Hidden />
			<Fill r="0" g="0" b="0" a="0.5" />
			<Window name="Export" w="400" h="320">
				<Title>$TR_EXPORT_TITLE</Title>
				<Center />
				<StaticText name="What" x="10" y="30">
					<Text>$TR_EXPORT_WHAT</Text>
				</StaticText>
				<RadioButton name="KindLevel" x="10" y="52" w="92" h="24">
					<Title>$TR_KIND_LEVEL</Title>
					<Group>1</Group>
					<ButtonLook />
				</RadioButton>
				<RadioButton name="KindCampaign" x="106" y="52" w="92" h="24">
					<Title>$TR_KIND_CAMPAIGN</Title>
					<Group>1</Group>
					<ButtonLook />
				</RadioButton>
				<RadioButton name="KindMusic" x="202" y="52" w="92" h="24">
					<Title>$TR_KIND_MUSIC</Title>
					<Group>1</Group>
					<ButtonLook />
				</RadioButton>
				<RadioButton name="KindSkin" x="298" y="52" w="92" h="24">
					<Title>$TR_KIND_SKIN</Title>
					<Group>1</Group>
					<ButtonLook />
				</RadioButton>
				<ListBox name="Items" x="10" y="88" w="284" h="182">
					<SubmitButton>Do</SubmitButton>
				</ListBox>
				<Button name="Refresh" x="298" y="88" w="92" h="24">
					<Title>$TR_REFRESH</Title>
					<Font>tooltip_font.xml</Font>
				</Button>
				<Button name="Do" x="10" y="280" w="130" h="30">
					<Title>$TR_EXPORT_DO</Title>
				</Button>
				<Button name="Cancel" x="260" y="280" w="130" h="30">
					<Title>$CANCEL</Title>
				</Button>
			</Window>
		</Element>

		<!-- Einmalig beim ersten Start von 1.2.0: der Hinweis auf den
		     CRT-Filter. Wer ihn nie im Optionsdialog sucht, erfaehrt sonst
		     nicht, dass es ihn gibt. -->
		<Element name="CrtPane" w="640" h="480">
			<Hidden />
			<Fill r="0" g="0" b="0" a="0.5" />
			<Window name="Crt" w="420" h="220">
				<Title>$MM_CRT_TITLE</Title>
				<Center />
				<StaticText name="Text" x="10" y="30" w="400" h="140">
					<WordWrap />
					<Text>$MM_CRT_TEXT</Text>
				</StaticText>
				<Button name="NoThanks" x="10" y="180" w="180" h="30">
					<Title>$MM_CRT_NO_THANKS</Title>
				</Button>
				<Button name="TryIt" x="230" y="180" w="180" h="30">
					<Title>$MM_CRT_TRY</Title>
				</Button>
			</Window>
		</Element>

		<!-- Wohin Import und Export ihre Rueckmeldung schreiben. Das
		     Hauptmenue hatte bisher keine. -->
		<Element name="MessagePane" w="640" h="480">
			<Hidden />
			<Fill r="0" g="0" b="0" a="0.5" />
			<Window name="Message" w="420" h="140">
				<Title>$TR_MESSAGE_TITLE</Title>
				<Center />
				<StaticText name="Text" x="15" y="35" w="390" h="60">
					<WordWrap />
					<Text></Text>
				</StaticText>
				<Button name="OK" x="145" y="100" w="130" h="30">
					<Title>$OK</Title>
				</Button>
			</Window>
		</Element>
	</Element>
</Dialog>