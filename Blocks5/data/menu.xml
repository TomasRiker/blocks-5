<?xml version="1.0" encoding="ISO-8859-1"?>
<Dialog>
	<Element name="Menu" x="0" y="0" w="640" h="480">
		<StaticText name="Version" x="5" y="5">
			<Font>tooltip_font.xml</Font>
		</StaticText>
		<!-- The cells in buttons.png are 80x80 (large buttons) and 50x50
		     (small ones), packed with no gaps: unpressed at column 0, pressed
		     at column 80 and 210 respectively. In both states the disc sits
		     centred in the cell, so x/y are offset up and to the left by the
		     border: 8 pixels for the large ones, 9 for the small. -->
		<Button name="StartGame" x="12" y="97" w="80" h="80">
			<ExtendedStyle inset="8" />
			<Font>tooltip_font.xml</Font>
			<Title>$MM_START_GAME</Title>
			<Image u="0" v="0" u2="80" v2="0">buttons.png</Image>
		</Button>
		<Button name="LevelEditor" x="97" y="82" w="80" h="80">
			<ExtendedStyle inset="8" />
			<Font>tooltip_font.xml</Font>
			<Title>$MM_LEVEL_EDITOR</Title>
			<Image u="0" v="80" u2="80" v2="80">buttons.png</Image>
		</Button>
		<Button name="CampaignEditor" x="182" y="77" w="80" h="80">
			<ExtendedStyle inset="8" />
			<Font>tooltip_font.xml</Font>
			<Title>$MM_CAMPAIGN_EDITOR</Title>
			<Image u="0" v="160" u2="80" v2="160">buttons.png</Image>
		</Button>
		<Button name="Manager" x="267" y="67" w="80" h="80">
			<ExtendedStyle inset="8" />
			<Font>tooltip_font.xml</Font>
			<Title>$MM_MANAGE</Title>
			<Image u="0" v="560" u2="80" v2="560">buttons.png</Image>
		</Button>
		<Button name="Options" x="468" y="52" w="80" h="80">
			<ExtendedStyle inset="8" />
			<Font>tooltip_font.xml</Font>
			<Title>$OPTIONS</Title>
			<Image u="0" v="240" u2="80" v2="240">buttons.png</Image>
		</Button>
		<Button name="Help" x="548" y="82" w="80" h="80">
			<ExtendedStyle inset="8" />
			<Font>tooltip_font.xml</Font>
			<Title>$HELP</Title>
			<Image u="0" v="320" u2="80" v2="320">buttons.png</Image>
		</Button>
		<Button name="Quit" x="547" y="377" w="80" h="80">
			<ExtendedStyle inset="8" />
			<Font>tooltip_font.xml</Font>
			<Title>$MM_QUIT</Title>
			<Image u="0" v="400" u2="80" v2="400">buttons.png</Image>
		</Button>
		<!-- The address at the top right belongs to menu.png and is not an
		     element of its own. This button just sits over it and draws
		     nothing; in the finished picture the text runs from x 474..636,
		     y 8..22. -->
		<Button name="Website" x="470" y="4" w="170" h="22">
			<ExtendedStyle />
			<Title></Title>
		</Button>
		<Button name="Donate" x="330" y="5" w="100" h="43">
			<ExtendedStyle />
			<Title></Title>
			<Image>$MM_DONATE_BUTTON_FILENAME</Image>
		</Button>
		<Element name="DonatePane" w="640" h="480">
			<Hidden />
			<Fill r="0" g="0" b="0" a="0.5" />
			<Window name="Donate" w="400" h="300">
				<Title>$MM_DONATE</Title>
				<Center />
				<StaticImage name="Static1" x="1" y="27" w="398" h="270">
					<Deactivated />
					<Image>$MM_DONATE_BACKGROUND_FILENAME</Image>
				</StaticImage>
				<Button name="NoThanks" x="200" y="260" w="100" h="30">
					<Title>$MM_DONATE_NO_THANKS</Title>
				</Button>
				<Button name="Donate" x="310" y="260" w="80" h="30">
					<Title>$MM_DONATE_DONATE</Title>
				</Button>
			</Window>
		</Element>

		<!-- The Manager. Five kinds along the top in 92-pixel columns and four
		     buttons along the bottom in four wider ones, both rows spanning
		     the same x=10..486: the captions decide the first width and the
		     window the second, and forcing one grid on both would either
		     cramp "Zusammenfuehren" or leave a hole where the fifth button
		     would be. -->
		<Element name="ManagerPane" w="640" h="480">
			<Hidden />
			<Fill r="0" g="0" b="0" a="0.5" />
			<Window name="Manager" w="496" h="320">
				<Title>$TR_MANAGER_TITLE</Title>
				<Center />
				<StaticText name="What" x="10" y="30">
					<Text>$TR_MANAGER_WHAT</Text>
				</StaticText>
				<RadioButton name="KindLevel" x="10" y="52" w="92" h="24">
					<Title>$TR_KIND_LEVEL</Title>
					<Group>1</Group>
					<ButtonLook />
				</RadioButton>
				<RadioButton name="KindCampaign" x="106" y="52" w="92" h="24">
					<Title>$TR_KIND_CAMPAIGN</Title>
					<Group>1</Group>
					<ButtonLook />
				</RadioButton>
				<RadioButton name="KindMusic" x="202" y="52" w="92" h="24">
					<Title>$TR_KIND_MUSIC</Title>
					<Group>1</Group>
					<ButtonLook />
				</RadioButton>
				<RadioButton name="KindSkin" x="298" y="52" w="92" h="24">
					<Title>$TR_KIND_SKIN</Title>
					<Group>1</Group>
					<ButtonLook />
				</RadioButton>
				<RadioButton name="KindProgress" x="394" y="52" w="92" h="24">
					<Title>$TR_KIND_PROGRESS</Title>
					<Group>1</Group>
					<ButtonLook />
				</RadioButton>
				<ListBox name="Items" x="10" y="88" w="380" h="182">
					<SubmitButton>Export</SubmitButton>
				</ListBox>
				<Button name="Refresh" x="394" y="88" w="92" h="24">
					<Title>$TR_REFRESH</Title>
					<Font>tooltip_font.xml</Font>
				</Button>
				<Button name="Import" x="10" y="280" w="116" h="30">
					<Title>$TR_IMPORT_DO</Title>
				</Button>
				<Button name="Export" x="130" y="280" w="116" h="30">
					<Title>$TR_EXPORT_DO</Title>
				</Button>
				<Button name="Delete" x="250" y="280" w="116" h="30">
					<Title>$TR_DELETE_DO</Title>
				</Button>
				<Button name="Close" x="370" y="280" w="116" h="30">
					<Title>$CLOSE</Title>
				</Button>
			</Window>
		</Element>

		<!-- The confirmation, before a delete and before an import replaces
		     something. It must come after the Manager, because the last child
		     in the XML is drawn last and takes the clicks.

		     Three columns, of which the middle one is used only where there
		     is a third answer - merging an imported progress with the one
		     already there. Yes and No therefore keep their places whether it
		     is shown or not, and the text is set from the code, so it is
		     wrapped rather than trusted to fit. -->
		<Element name="ConfirmPane" w="640" h="480">
			<Hidden />
			<Window name="Confirm" w="445" h="120">
				<Title>$TR_CONFIRM_TITLE</Title>
				<Center />
				<StaticText name="Text" x="10" y="30" w="425" h="40">
					<Text>$TR_CONFIRM_DELETE</Text>
					<WordWrap />
				</StaticText>
				<Button name="Yes" x="10" y="80" w="135" h="30">
					<Title>$YES</Title>
				</Button>
				<Button name="Merge" x="155" y="80" w="135" h="30">
					<Title>$TR_MERGE_DO</Title>
					<Hidden />
				</Button>
				<Button name="No" x="300" y="80" w="135" h="30">
					<Title>$NO</Title>
				</Button>
			</Window>
		</Element>

		<!-- Once, on the first start of 1.2.0: the offer of the CRT
		     filter. -->
		<Element name="CrtPane" w="640" h="480">
			<Hidden />
			<Fill r="0" g="0" b="0" a="0.5" />
			<Window name="Crt" w="420" h="220">
				<Title>$MM_CRT_TITLE</Title>
				<Center />
				<StaticText name="Text" x="10" y="30" w="400" h="140">
					<WordWrap />
					<Text>$MM_CRT_TEXT</Text>
				</StaticText>
				<Button name="NoThanks" x="10" y="180" w="180" h="30">
					<Title>$MM_CRT_NO_THANKS</Title>
				</Button>
				<Button name="TryIt" x="230" y="180" w="180" h="30">
					<Title>$MM_CRT_TRY</Title>
				</Button>
			</Window>
		</Element>
	</Element>
</Dialog>