<?xml version="1.0" encoding="ISO-8859-1"?>
<Dialog>
	<Window name="Options" w="340" h="465">
		<Title>$OPTIONS</Title>
		<Center />
		<Hidden />
		<StaticText name="Static1" x="10" y="30">
			<Text>$O_LANGUAGE</Text>
		</StaticText>
		<StaticImage name="Static3" x="10" y="50" w="64" h="48" for="English">
			<Image u="80" v="0">languages.png</Image>
		</StaticImage>
		<RadioButton name="English" x="10" y="105" w="16" h="16">
			<Title>$O_LANGUAGE_ENGLISH</Title>
			<Group>0</Group>
		</RadioButton>
		<StaticImage name="Static2" x="110" y="50" w="64" h="48" for="German">
			<Image u="0" v="0">languages.png</Image>
		</StaticImage>
		<RadioButton name="German" x="110" y="105" w="16" h="16">
			<Title>$O_LANGUAGE_GERMAN</Title>
			<Group>0</Group>
		</RadioButton>

		<StaticText name="Static11" x="210" y="30">
			<Text>$O_UPSCALER</Text>
		</StaticText>
		<RadioButton name="SharpFit" x="210" y="50" w="16" h="16">
			<Title>$O_UPSCALER_SHARP_FIT</Title>
			<Group>2</Group>
			<Font>tooltip_font.xml</Font>
		</RadioButton>
		<RadioButton name="Sharp" x="210" y="70" w="16" h="16">
			<Title>$O_UPSCALER_NEAREST</Title>
			<Group>2</Group>
			<Font>tooltip_font.xml</Font>
		</RadioButton>
		<RadioButton name="Smooth" x="210" y="90" w="16" h="16">
			<Title>$O_UPSCALER_BILINEAR</Title>
			<Group>2</Group>
			<Font>tooltip_font.xml</Font>
		</RadioButton>
		<RadioButton name="Crt" x="210" y="110" w="16" h="16">
			<Title>$O_UPSCALER_CRT</Title>
			<Group>2</Group>
			<Font>tooltip_font.xml</Font>
		</RadioButton>
		<Button name="CrtSettings" x="210" y="130" w="120" h="18">
			<Title>$O_CRT_SETTINGS</Title>
			<Font>tooltip_font.xml</Font>
		</Button>

		<StaticText name="Static4" x="10" y="140">
			<Text>$O_VOLUME</Text>
		</StaticText>
		<!-- The effects, the levels' music and the menu's, which the level
		     selection and both editors play as well. The labels are in the
		     small font, as the filters' are, so that the sliders keep most
		     of their length: "Game music:" is 87 pixels wide in the large
		     one and 65 in this, and the sliders begin 7 empty columns after
		     it. At 100 a value ends
		     at 330, where the key buttons below end: "100" is 24 pixels wide
		     in its font. Each slider keeps its distance to its value. -->
		<StaticText name="Static5" x="10" y="163" w="-1" h="-1"><Text>$O_VOLUME_EFFECTS</Text><Font>tooltip_font.xml</Font></StaticText>
		<StaticText name="SoundVolumeValue" x="306" y="160"><Text></Text></StaticText>
		<ScrollBar name="SoundVolume" x="82" y="160" w="214" h="16"><Receiver>SoundVolumeValue</Receiver><AreaSize>120</AreaSize><PageSize>20</PageSize></ScrollBar>
		<StaticText name="Static6" x="10" y="183" w="-1" h="-1"><Text>$O_VOLUME_MUSIC</Text><Font>tooltip_font.xml</Font><ToolTip>$O_VOLUME_MUSIC_TIP</ToolTip></StaticText>
		<StaticText name="MusicVolumeValue" x="306" y="180"><Text></Text></StaticText>
		<ScrollBar name="MusicVolume" x="82" y="180" w="214" h="16"><Receiver>MusicVolumeValue</Receiver><AreaSize>120</AreaSize><PageSize>20</PageSize></ScrollBar>
		<StaticText name="Static12" x="10" y="203" w="-1" h="-1"><Text>$O_VOLUME_MENU_MUSIC</Text><Font>tooltip_font.xml</Font><ToolTip>$O_VOLUME_MENU_MUSIC_TIP</ToolTip></StaticText>
		<StaticText name="MenuMusicVolumeValue" x="306" y="200"><Text></Text></StaticText>
		<ScrollBar name="MenuMusicVolume" x="82" y="200" w="214" h="16"><Receiver>MenuMusicVolumeValue</Receiver><AreaSize>120</AreaSize><PageSize>20</PageSize></ScrollBar>

		<!-- On the buttons' row rather than over it: that row is the room the
		     third slider takes, and the window cannot grow. The buttons
		     stand in the sliders' column, 94 apart. -->
		<StaticText name="Static7" x="10" y="230">
			<Text>$O_DETAILS</Text>
		</StaticText>
		<RadioButton name="LowDetails" x="82" y="230" w="16" h="16">
			<Title>$O_DETAILS_LOW</Title>
			<Group>1</Group>
		</RadioButton>
		<RadioButton name="MediumDetails" x="176" y="230" w="16" h="16">
			<Title>$O_DETAILS_MEDIUM</Title>
			<Group>1</Group>
		</RadioButton>
		<RadioButton name="HighDetails" x="270" y="230" w="16" h="16">
			<Title>$O_DETAILS_HIGH</Title>
			<Group>1</Group>
		</RadioButton>

    <StaticText name="Static8" x="10" y="260">
      <Text>$O_CONTROLS</Text>
    </StaticText>
    <ListBox name="Actions" x="10" y="280" w="170" h="75">
      <Font>tooltip_font.xml</Font>
    </ListBox>
    <!-- Resetting, in two strengths: two buttons stacked under the list,
         as wide as it is. Whole sentences on them, because a label in
         front and two short words after it would work out in only one of
         the two languages. -->
    <Button name="ResetSelected" x="10" y="365" w="170" h="20">
      <Title>$O_RESET_SELECTED</Title>
      <Font>tooltip_font.xml</Font>
    </Button>
    <Button name="ResetAll" x="10" y="390" w="170" h="20">
      <Title>$O_RESET_ALL</Title>
      <Font>tooltip_font.xml</Font>
    </Button>
    <StaticText name="Static9" x="190" y="280">
      <Text>$O_PRIMARY_KEY</Text>
      <Font>tooltip_font.xml</Font>
    </StaticText>
    <Button name="PrimaryKey" x="190" y="292" w="140" h="20">
      <Title/>
      <Font>tooltip_font.xml</Font>
    </Button>
    <StaticText name="Static10" x="190" y="323">
      <Text>$O_SECONDARY_KEY</Text>
      <Font>tooltip_font.xml</Font>
    </StaticText>
    <Button name="SecondaryKey" x="190" y="335" w="140" h="20">
      <Title/>
      <Font>tooltip_font.xml</Font>
    </Button>
    <!-- The update check, beside the two reset buttons: a box with its label
         beside it, two lines in the small font, since neither language fits
         the column on one. Options.cpp hides both in the browser, and under
         Linux where neither curl nor wget is installed. The label is
         placed as a box places its own caption, 6 columns after the box
         (CAPTION_GAP in gui_element.cpp) and centred on it, here both
         lines together: two rows above the box and two below. -->
    <CheckBox name="UpdateCheck" x="190" y="366" w="16" h="16">
      <Title></Title>
      <ToolTip>$O_UPDATE_CHECK_TIP</ToolTip>
    </CheckBox>
    <StaticText name="UpdateCheckLabel" x="212" y="364" w="120" h="26" for="UpdateCheck">
      <Text>$O_UPDATE_CHECK</Text>
      <Font>tooltip_font.xml</Font>
      <WordWrap />
      <ToolTip>$O_UPDATE_CHECK_TIP</ToolTip>
    </StaticText>

    <Button name="OK" x="10" y="425" w="155" h="30">
			<Title>OK</Title>
		</Button>
		<Button name="Cancel" x="175" y="425" w="155" h="30">
			<Title>$CANCEL</Title>
		</Button>
	</Window>

	<!-- The CRT filter's sliders. A window of their own, because there is
	     no room left in the options window - none may be taller than 480.
	     The sliders take effect at once; Cancel fetches the old values
	     back through loadConfig(). -->
	<Window name="CrtOptions" w="300" h="412">
		<Title>$O_CRT_SETTINGS_TITLE</Title>
		<Center />
		<Hidden />
		<StaticText name="ScanText" x="12" y="34" w="270" h="14">
			<Text>$O_CRT_SCANLINE</Text>
			<Font>tooltip_font.xml</Font>
		</StaticText>
		<StaticText name="ScanValue" x="258" y="50"><Text></Text></StaticText>
		<ScrollBar name="Scan" x="12" y="50" w="235" h="16">
			<Receiver>ScanValue</Receiver><AreaSize>120</AreaSize><PageSize>20</PageSize>
		</ScrollBar>
		<StaticText name="CurveText" x="12" y="82" w="270" h="14">
			<Text>$O_CRT_CURVATURE</Text>
			<Font>tooltip_font.xml</Font>
		</StaticText>
		<StaticText name="CurveValue" x="258" y="98"><Text></Text></StaticText>
		<ScrollBar name="Curve" x="12" y="98" w="235" h="16">
			<Receiver>CurveValue</Receiver><AreaSize>120</AreaSize><PageSize>20</PageSize>
		</ScrollBar>
		<StaticText name="BloomText" x="12" y="130" w="270" h="14">
			<Text>$O_CRT_BLOOM</Text>
			<Font>tooltip_font.xml</Font>
		</StaticText>
		<StaticText name="BloomValue" x="258" y="146"><Text></Text></StaticText>
		<ScrollBar name="Bloom" x="12" y="146" w="235" h="16">
			<Receiver>BloomValue</Receiver><AreaSize>120</AreaSize><PageSize>20</PageSize>
		</ScrollBar>
		<StaticText name="FlickerText" x="12" y="178" w="270" h="14">
			<Text>$O_CRT_FLICKER</Text>
			<Font>tooltip_font.xml</Font>
		</StaticText>
		<StaticText name="FlickerValue" x="258" y="194"><Text></Text></StaticText>
		<ScrollBar name="Flicker" x="12" y="194" w="235" h="16">
			<Receiver>FlickerValue</Receiver><AreaSize>120</AreaSize><PageSize>20</PageSize>
		</ScrollBar>
		<StaticText name="ScanFlickerText" x="12" y="226" w="270" h="14">
			<Text>$O_CRT_SCANFLICKER</Text>
			<Font>tooltip_font.xml</Font>
		</StaticText>
		<StaticText name="ScanFlickerValue" x="258" y="242"><Text></Text></StaticText>
		<ScrollBar name="ScanFlicker" x="12" y="242" w="235" h="16">
			<Receiver>ScanFlickerValue</Receiver><AreaSize>120</AreaSize><PageSize>20</PageSize>
		</ScrollBar>
		<StaticText name="ConvergeText" x="12" y="274" w="270" h="14">
			<Text>$O_CRT_CONVERGENCE</Text>
			<Font>tooltip_font.xml</Font>
		</StaticText>
		<StaticText name="ConvergeValue" x="258" y="290"><Text></Text></StaticText>
		<ScrollBar name="Converge" x="12" y="290" w="235" h="16">
			<Receiver>ConvergeValue</Receiver><AreaSize>120</AreaSize><PageSize>20</PageSize>
		</ScrollBar>
		<StaticText name="RewindText" x="12" y="322" w="270" h="14">
			<Text>$O_CRT_REWIND</Text>
			<Font>tooltip_font.xml</Font>
		</StaticText>
		<StaticText name="RewindValue" x="258" y="338"><Text></Text></StaticText>
		<ScrollBar name="Rewind" x="12" y="338" w="235" h="16">
			<Receiver>RewindValue</Receiver><AreaSize>120</AreaSize><PageSize>20</PageSize>
		</ScrollBar>
		<Button name="Close" x="85" y="370" w="130" h="26">
			<Title>OK</Title>
		</Button>
	</Window>
</Dialog>