<?xml version="1.0" encoding="ISO-8859-1"?>
<Dialog>
	<Window name="Options" w="340" h="440">
		<Title>$OPTIONS</Title>
		<Center />
		<Hidden />
		<StaticText name="Static1" x="10" y="30">
			<Text>$O_LANGUAGE</Text>
		</StaticText>
		<StaticImage name="Static3" x="10" y="50" w="64" h="48">
			<Image u="80" v="0">languages.png</Image>
		</StaticImage>
		<RadioButton name="English" x="10" y="105" w="16" h="16">
			<Title>$O_LANGUAGE_ENGLISH</Title>
			<Group>0</Group>
		</RadioButton>
		<StaticImage name="Static2" x="100" y="50" w="64" h="48">
			<Image u="0" v="0">languages.png</Image>
		</StaticImage>
		<RadioButton name="German" x="100" y="105" w="16" h="16">
			<Title>$O_LANGUAGE_GERMAN</Title>
			<Group>0</Group>
		</RadioButton>

		<StaticText name="Static11" x="215" y="30">
			<Text>$O_UPSCALER</Text>
		</StaticText>
		<!-- Die y-Werte setzt Options::show(); hier stehen sie nur der
		     Vollstaendigkeit halber schon an ihrem Platz. -->
		<RadioButton name="SharpFit" x="215" y="52" w="16" h="16">
			<Title></Title>
			<Group>2</Group>
		</RadioButton>
		<StaticText name="SharpFitLabel" x="241" y="55" w="90" h="14">
			<Text>$O_UPSCALER_SHARP_FIT</Text>
			<For>SharpFit</For>
			<Font>tooltip_font.xml</Font>
		</StaticText>
		<RadioButton name="Nearest" x="215" y="71" w="16" h="16">
			<Title></Title>
			<Group>2</Group>
		</RadioButton>
		<StaticText name="NearestLabel" x="241" y="74" w="90" h="14">
			<Text>$O_UPSCALER_NEAREST</Text>
			<For>Nearest</For>
			<Font>tooltip_font.xml</Font>
		</StaticText>
		<RadioButton name="Bilinear" x="215" y="90" w="16" h="16">
			<Title></Title>
			<Group>2</Group>
		</RadioButton>
		<StaticText name="BilinearLabel" x="241" y="93" w="90" h="14">
			<Text>$O_UPSCALER_BILINEAR</Text>
			<For>Bilinear</For>
			<Font>tooltip_font.xml</Font>
		</StaticText>
		<RadioButton name="Crt" x="215" y="109" w="16" h="16">
			<Title></Title>
			<Group>2</Group>
		</RadioButton>
		<StaticText name="CrtLabel" x="241" y="112" w="90" h="14">
			<Text>$O_UPSCALER_CRT</Text>
			<For>Crt</For>
			<Font>tooltip_font.xml</Font>
		</StaticText>
		<!-- y setzt Options::show(), direkt unter den letzten sichtbaren
		     Eintrag der Liste. -->
		<Button name="CrtSettings" x="215" y="132" w="115" h="18">
			<Title>$O_CRT_SETTINGS</Title>
			<Font>tooltip_font.xml</Font>
		</Button>

		<StaticText name="Static4" x="10" y="140">
			<Text>$O_VOLUME</Text>
		</StaticText>
		<StaticText name="Static5" x="10" y="160"><Text>$O_VOLUME_EFFECTS</Text></StaticText>
		<StaticText name="SoundVolumeValue" x="300" y="160"><Text></Text></StaticText>
		<ScrollBar name="SoundVolume" x="70" y="160" w="220" h="16"><Receiver>SoundVolumeValue</Receiver><AreaSize>120</AreaSize><PageSize>20</PageSize></ScrollBar>
		<StaticText name="Static6" x="10" y="180"><Text>$O_VOLUME_MUSIC</Text></StaticText>
		<StaticText name="MusicVolumeValue" x="300" y="180"><Text></Text></StaticText>
		<ScrollBar name="MusicVolume" x="70" y="180" w="220" h="16"><Receiver>MusicVolumeValue</Receiver><AreaSize>120</AreaSize><PageSize>20</PageSize></ScrollBar>

		<StaticText name="Static7" x="10" y="210">
			<Text>$O_DETAILS</Text>
		</StaticText>

		<RadioButton name="LowDetails" x="10" y="230" w="16" h="16">
			<Title>$O_DETAILS_LOW</Title>
			<Group>1</Group>
		</RadioButton>
		<RadioButton name="MediumDetails" x="100" y="230" w="16" h="16">
			<Title>$O_DETAILS_MEDIUM</Title>
			<Group>1</Group>
		</RadioButton>
		<RadioButton name="HighDetails" x="190" y="230" w="16" h="16">
			<Title>$O_DETAILS_HIGH</Title>
			<Group>1</Group>
		</RadioButton>

    <StaticText name="Static8" x="10" y="260">
      <Text>$O_CONTROLS</Text>
    </StaticText>
    <ListBox name="Actions" x="10" y="280" w="170" h="80">
      <Font>tooltip_font.xml</Font>
    </ListBox>
    <Button name="ResetControls" x="10" y="365" w="170" h="20">
      <Title>$O_RESET_CONTROLS</Title>
      <Font>tooltip_font.xml</Font>
    </Button>
    <StaticText name="Static9" x="185" y="280">
      <Text>$O_PRIMARY_KEY</Text>
      <Font>tooltip_font.xml</Font>
    </StaticText>
    <Button name="PrimaryKey" x="185" y="295" w="145" h="20">
      <Title/>
      <Font>tooltip_font.xml</Font>
    </Button>
    <StaticText name="Static10" x="185" y="320">
      <Text>$O_SECONDARY_KEY</Text>
      <Font>tooltip_font.xml</Font>
    </StaticText>
    <Button name="SecondaryKey" x="185" y="335" w="145" h="20">
      <Title/>
      <Font>tooltip_font.xml</Font>
    </Button>

    <Button name="OK" x="10" y="400" w="135" h="30">
			<Title>OK</Title>
		</Button>
		<Button name="Cancel" x="155" y="400" w="135" h="30">
			<Title>§de:Abbrechen§en:Cancel</Title>
		</Button>
	</Window>

	<!-- Die Regler des Roehrenfilters. Ein eigenes Fenster, weil im
	     Optionsfenster kein Platz mehr ist: 340x440 sind voll, und hoeher
	     darf es nicht werden - das Spielbild ist nur 480 hoch. Beide Regler
	     wirken sofort, damit man beim Schieben sieht, was sie tun;
	     Abbrechen im Optionsfenster holt ueber loadConfig() die alten Werte
	     zurueck. -->
	<Window name="CrtOptions" w="300" h="250">
		<Title>$O_CRT_SETTINGS</Title>
		<Center />
		<Hidden />
		<StaticText name="CrtScanText" x="12" y="32" w="270" h="14">
			<Text>$O_CRT_SCANLINE</Text>
			<Font>tooltip_font.xml</Font>
		</StaticText>
		<StaticText name="CrtScanValue" x="258" y="50"><Text></Text></StaticText>
		<ScrollBar name="CrtScan" x="12" y="50" w="235" h="16">
			<Receiver>CrtScanValue</Receiver><AreaSize>120</AreaSize><PageSize>20</PageSize>
		</ScrollBar>
		<StaticText name="CrtCurveText" x="12" y="76" w="270" h="14">
			<Text>$O_CRT_CURVATURE</Text>
			<Font>tooltip_font.xml</Font>
		</StaticText>
		<StaticText name="CrtCurveValue" x="258" y="94"><Text></Text></StaticText>
		<ScrollBar name="CrtCurve" x="12" y="94" w="235" h="16">
			<Receiver>CrtCurveValue</Receiver><AreaSize>120</AreaSize><PageSize>20</PageSize>
		</ScrollBar>
		<StaticText name="CrtBloomText" x="12" y="120" w="270" h="14">
			<Text>$O_CRT_BLOOM</Text>
			<Font>tooltip_font.xml</Font>
		</StaticText>
		<StaticText name="CrtBloomValue" x="258" y="138"><Text></Text></StaticText>
		<ScrollBar name="CrtBloom" x="12" y="138" w="235" h="16">
			<Receiver>CrtBloomValue</Receiver><AreaSize>120</AreaSize><PageSize>20</PageSize>
		</ScrollBar>
		<StaticText name="CrtFlickerText" x="12" y="164" w="270" h="14">
			<Text>$O_CRT_FLICKER</Text>
			<Font>tooltip_font.xml</Font>
		</StaticText>
		<StaticText name="CrtFlickerValue" x="258" y="182"><Text></Text></StaticText>
		<ScrollBar name="CrtFlicker" x="12" y="182" w="235" h="16">
			<Receiver>CrtFlickerValue</Receiver><AreaSize>120</AreaSize><PageSize>20</PageSize>
		</ScrollBar>
		<Button name="CrtClose" x="85" y="212" w="130" h="26">
			<Title>OK</Title>
		</Button>
	</Window>
</Dialog>