<?xml version="1.0" encoding="ISO-8859-1"?>
<Dialog>
	<Element name="SelectLevel" x="0" y="0" w="640" h="480">
		<Hidden />
		<StaticText name="Static1" x="40" y="40">
      <Text>$LS_SELECT_CAMPAIGN</Text>
		</StaticText>
    <ListBox name="Campaigns" x="40" y="60" w="220" h="150" />
    <StaticText name="ProgressLabel" x="40" y="220">
      <Text>$LS_PROGRESS</Text>
    </StaticText>
    <StaticText name="Static3" x="40" y="280">
      <Text>$LS_CAMPAIGN_DESCRIPTION</Text>
    </StaticText>
    <StaticText name="CampaignDescription" x="40" y="300" w="220" h="100">
      <Color r="0.75" g="0.75" b="0.75"/>
      <WordWrap />
      <Text></Text>
    </StaticText>
    <StaticText name="Static3" x="280" y="40">
      <Text>$LS_SELECT_LEVEL</Text>
    </StaticText>
    <!-- Die Scheibe liegt in beiden Zustaenden mittig im Feld; x/y stehen
         deshalb um den Rand nach oben links versetzt: 9 Pixel bei den
         kleinen Knoepfen, 8 bei den grossen. -->
    <Button name="FirstLevel" x="279" y="296" w="50" h="50">
      <Title></Title>
	<ExtendedStyle inset="9" />
	<Image u="160" v="0" u2="210" v2="0">buttons.png</Image>
      <ToolTip>$LS_FIRST_LEVEL</ToolTip>
    </Button>
    <Button name="PreviousLevel" x="319" y="296" w="50" h="50">
      <Title></Title>
	<ExtendedStyle inset="9" />
	<Image u="160" v="50" u2="210" v2="50">buttons.png</Image>
      <ToolTip>$LS_PREVIOUS_LEVEL</ToolTip>
    </Button>
    <Button name="PlayLevel" x="400" y="292" w="80" h="80">
      <Title></Title>
	<ExtendedStyle inset="8" />
	<Image u="0" v="480" u2="80" v2="480">buttons.png</Image>
      <ToolTip>$LS_PLAY_LEVEL</ToolTip>
    </Button>
    <Button name="NextLevel" x="509" y="296" w="50" h="50">
      <Title></Title>
	<ExtendedStyle inset="9" />
	<Image u="160" v="100" u2="210" v2="100">buttons.png</Image>
      <ToolTip>$LS_NEXT_LEVEL</ToolTip>
    </Button>
    <Button name="NextLevelToDo" x="501" y="331" w="50" h="50">
      <Title></Title>
	<ExtendedStyle inset="9" />
	<Image u="160" v="200" u2="210" v2="200">buttons.png</Image>
      <ToolTip>$LS_NEXT_LEVEL_TO_DO</ToolTip>
    </Button>
    <Button name="LastLevel" x="549" y="296" w="50" h="50">
      <Title></Title>
	<ExtendedStyle inset="9" />
	<Image u="160" v="150" u2="210" v2="150">buttons.png</Image>
      <ToolTip>$LS_LAST_LEVEL</ToolTip>
    </Button>
	<Button name="Quit" x="22" y="392" w="80" h="80">
		<ExtendedStyle inset="8" />
		<Font>tooltip_font.xml</Font>
		<Title>$LS_QUIT</Title>
		<Image u="0" v="400" u2="80" v2="400">buttons.png</Image>
	</Button>
    <StaticText name="Note" x="150" y="425" w="500" h="80">
      <Text />
      <WordWrap />
      <Font>tooltip_font.xml</Font>
    </StaticText>
	</Element>
</Dialog>