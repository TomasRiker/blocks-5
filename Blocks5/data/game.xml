<?xml version="1.0" encoding="ISO-8859-1"?>
<Dialog>
	<Button name="ShowMenu" x="544" y="427" w="65" h="25">
		<Title>$G_SHOW_MENU</Title>
	</Button>
	<Element name="MenuPane" w="640" h="480">
		<Hidden />
		<Window name="Menu" w="350" h="260">
			<Title>$G_MENU_TITLE</Title>
			<Center />
			<Button name="Continue" y="50" w="300" h="25">
				<Title>$G_MENU_CONTINUE</Title>
				<HCenter />
			</Button>
			<Button name="Restart" y="80" w="300" h="25">
				<Title>$G_MENU_RESTART</Title>
				<HCenter />
			</Button>
			<Button name="RestartFromHotel" y="110" w="300" h="25">
				<Title>$G_MENU_RESTART_FROM_HOTEL</Title>
				<HCenter />
			</Button>
			<Button name="Options" y="140" w="300" h="25">
				<Title>$OPTIONS</Title>
				<HCenter />
			</Button>
			<Button name="Help" y="170" w="300" h="25">
				<Title>$HELP</Title>
				<HCenter />
			</Button>
			<Button name="Quit" y="200" w="300" h="25">
				<Title></Title>
				<HCenter />
			</Button>
		</Window>
		<!-- x/y sind um den Rand von 8 Pixeln nach oben links versetzt. Dass
		     das Feld drei Pixel ueber den Bildrand hinausragt, macht nichts:
		     dort ist ohnehin nur Rand. -->
		<Button name="Quit" x="562" y="-3" w="80" h="80">
			<ExtendedStyle inset="8" />
			<Font>tooltip_font.xml</Font>
			<Title>$MM_QUIT</Title>
			<Image u="0" v="400" u2="80" v2="400">buttons.png</Image>
		</Button>
	</Element>
</Dialog>